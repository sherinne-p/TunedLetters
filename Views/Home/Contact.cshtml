@{
    ViewData["Title"] = "Contact";
}

<h2 class="mb-3">Contact</h2>
<p class="text-muted">This form is for display only and does not send messages.</p>

<form novalidate>
    <div class="mb-3">
        <label class="form-label" for="name">Name</label>
        <input id="name" class="form-control" placeholder="Your name" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input id="email" class="form-control" type="email" placeholder="you@example.com" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="message">Message</label>
        <textarea id="message" class="form-control" rows="4" placeholder="Your message"></textarea>
    </div>
    <button type="button" class="btn btn-primary">Send</button>
</form>
