@{
    ViewData["Title"] = "Playlists";
}

<h2 class="mb-3">Featured Playlist</h2>
<p class="text-muted">
    This page showcases my real Spotify playlist "Liham sa Laham" in a Spotify-like dark theme.
</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 p-3">
            <div style="width: 100%; padding-top: 100%; background:#000; border-radius:8px; position:relative; overflow:hidden; margin-bottom:1rem;">
                <span class="position-absolute top-50 start-50 translate-middle fw-bold fs-5">
                    Liham sa Laham
                </span>
            </div>
            <h4 class="fw-bold">Liham sa Laham</h4>
            <p class="text-muted">
                A collection of songs that read like heartfelt letters — the core of Tuned Letters.
            </p>
            <a href="https://open.spotify.com/playlist/5fMKkwbPuWuUdej3PSoCjf?si=Sn29rbYhQYKa05oT0NPv6g"
               target="_blank"
               class="btn btn-primary">
                Open in Spotify
            </a>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card h-100 p-3">
            <h5 class="mb-3">Embedded Player</h5>
            <p class="text-muted">This embedded player is from Spotify and is here for display only.</p>

            <!-- Your Spotify embed -->
            <iframe data-testid="embed-iframe" style="border-radius:12px"
                    src="https://open.spotify.com/embed/playlist/5fMKkwbPuWuUdej3PSoCjf?utm_source=generator"
                    width="100%" height="352" frameborder="0" allowfullscreen=""
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                    loading="lazy">
            </iframe>
        </div>
    </div>
</div>
